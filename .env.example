# =====================================================================
# NASA MODIS & VIIRS Wildfire Harmonization Platform - Environment Config
# =====================================================================

# 1. Local Data Lake Paths (Used by ETL & DuckDB Engine)
DATASET_RAW_DIR=/home/shehab/FILES/NASA_SPACE_APP/DATASET
PROCESSED_DATA_DIR=/home/shehab/FILES/NASA_SPACE_APP/NASA_SPACE_APP/data/processed

# 2. Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development

# 3. NASA FIRMS API Key (OPTIONAL)
# NOTE: NOT needed to run the current app or process the downloaded 41GB dataset.
# Only required if you want to stream future Near-Real-Time (NRT) fire detections
# Get your free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

